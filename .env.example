# Copy to .env.local (not committed). Read by `npm run dev` and the builds.

# true = every screen runs on sample data (src/mock/), no backend, no Razorpay.
# false = call the real backend at VITE_API_BASE with VITE_DEV_TOKEN.
# Keep this false (or remove it) before `npm run build` for the WordPress plugin.
VITE_MOCK_API=false

# Backend for the standalone dev page (http://localhost:5173).
VITE_API_BASE=https://api.staging.petzadore.com

# Session token for that backend. Tokens last 15 minutes; the app shows
# "You've been logged out" when it expires. To get one for staging, either:
#  - log in on https://staging.petzadore.com, open the insurance page, and run
#    PetzadoreInsurance.token in the browser console, or
#  - on the staging backend: npm run token:dev -- <wpUserId> "<name>" <email>
VITE_DEV_TOKEN=nDkr3iHgUeciWcLO2Z0rA3eSZt4-xQg3gKxZKkX9D4iEA_Gmx70OYJosBKQjFmdx

# WordPress sites allowed to load the app from this dev server (comma-separated).
VITE_WP_ORIGINS=https://staging.petzadore.com

# Dev server port (staging's API only accepts browser calls from http://localhost:5173).
VITE_DEV_PORT=5173
